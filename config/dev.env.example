# Copiar a config/dev.env. Valores planos; no se ejecuta como shell.
GCP_PROJECT_ID=
GCP_REGION=
GCP_LOCATION=
RESOURCE_SUFFIX=
ENVIRONMENT=dev
BOOTSTRAP_ACCOUNT=
EVENTS_TOPIC_ID=rs-dev-str-ps-events
EVENTS_SUBSCRIPTION_ID=rs-dev-str-ps-events-dataflow
INSIGHTS_TOPIC_ID=rs-dev-str-ps-insights
BRONZE_BUCKET=rs-dev-data-gcs-bronze-<suffix>
SILVER_BUCKET=rs-dev-data-gcs-silver-<suffix>
DATAFLOW_BUCKET=rs-dev-str-gcs-dataflow-<suffix>
GOLD_DATASET_ID=rs_dev_gold
DATAFLOW_SERVICE_ACCOUNT_ID=rs-dev-str-sa-dataflow
DEPLOYER_SERVICE_ACCOUNT_ID=rs-dev-sec-sa-deployer
# Regiones explícitas de residencia; vacío conserva política organizacional.
PUBSUB_ALLOWED_REGIONS=
ACK_DEADLINE_SECONDS=60
MESSAGE_RETENTION_SECONDS=604800
# never o segundos (al menos la retención).
SUBSCRIPTION_EXPIRATION=never
